<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Adds the local folder feed used during development of the KGSM ecosystem
    (/home/heisen/local-nuget), merged with the global sources (nuget.org,
    github) so their credentials are preserved.

    kgsm-firewall itself takes NO TheKrystalShip package dependency (it is a
    standalone privileged helper, deliberately free of any kgsm-lib reference to
    avoid a dependency cycle — kgsm-lib consumes the Firewall.Contracts package,
    not the other way round). This feed is here so the Firewall.Contracts package
    (added in a later increment) can be packed and resolved locally.
  -->
  <packageSources>
    <add key="local-thekrystalship" value="/home/heisen/local-nuget" />
  </packageSources>
</configuration>
