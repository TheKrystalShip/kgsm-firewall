<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Native AOT: a privileged firewall authority should be a small, fast, no-JIT image.
         It is socket-activated and transient (it supervises nothing), so it must start instantly
         and leave no resident footprint between the infrequent firewall operations it performs. -->
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsAotCompatible>true</IsAotCompatible>

    <!-- Plain Microsoft.NET.Sdk (NOT Sdk.Web), deliberately. Unlike kgsm-watchdog/kgsm-monitor — which
         serve an HTTP control surface and so take the ASP.NET shared framework — this helper only reads
         a request off a unix socket and shells out to ufw/firewall-cmd/nft. Pulling the whole ASP.NET
         stack into a root-capable process is gratuitous attack surface; a console host + raw unix socket
         is leaner and more appropriate for a privileged door. -->

    <!-- Workstation, non-concurrent GC: this does tiny, bursty work, never a steady-state load, so
         Server GC's per-core heaps would be pure waste (same reasoning as kgsm-watchdog). -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>

    <RootNamespace>TheKrystalShip.KGSM.Firewall</RootNamespace>
    <AssemblyName>kgsm-firewall</AssemblyName>
    <Version>1.11.1</Version>

    <!-- Footprint tuning for the AOT image (mirrors kgsm-watchdog): there is no hot path to speed up,
         so trade throughput for a smaller native image. -->
    <OptimizationPreference>Size</OptimizationPreference>
    <IlcFoldIdenticalMethodBodies>true</IlcFoldIdenticalMethodBodies>
    <StripSymbols>true</StripSymbols>
    <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>

    <!-- The leaf config descriptor is generated from FirewallSettings. These name the two files the
         generator works between; the attribute source, the documentation file the <panel> tags travel
         in, and the build step all come with the package below. -->
    <LeafSettingsFile>kgsm-firewall.settings.json</LeafSettingsFile>
    <LeafDescriptorFile>$(MSBuildProjectDirectory)/../../deploy/kgsm-firewall.leaf.json</LeafDescriptorFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Build-only: the descriptor attributes arrive as source and the generator as a tool, and the
         package declares no dependencies, so nothing here reaches the AOT publish. Not a kgsm-lib
         dependency by any route — this package has none. -->
    <PackageReference Include="TheKrystalShip.KGSM.LeafConfig" Version="2.2.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Standard ecosystem logging: SystemdConsole (journald-native) formatter + settings-file/env
         level config, no DI/hosting host pulled in (a console host + raw unix socket, no ASP.NET). These
         packages are AOT-safe (the logging config binder reads the LogLevel keys directly, no reflection). NO
         TheKrystalShip.KGSM.Lib reference: kgsm-firewall must not depend on kgsm-lib (kgsm-lib consumes
         Firewall.Contracts, not vice versa) — that would be a dependency cycle. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="kgsm-firewall.settings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- The wire contract now lives in the standalone Contracts package — one definition shared with
         kgsm-lib so the two cannot drift. The daemon consumes it as a project reference (the same
         project is packed to local-nuget for kgsm-lib to resolve). A net9.0 lib inside this net10.0
         AOT app publishes clean; verified by the 0-warn ILC gate. -->
    <ProjectReference Include="..\Firewall.Contracts\Firewall.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The journal's WRITE half only, and deliberately not kgsm-lib: this daemon runs as root, and a
         process runner, an RCON client and a set of HTTP clients are attack surface a firewall authority
         has no use for. The package's whole dependency is Logging.Abstractions, which is already here. -->
    <PackageReference Include="TheKrystalShip.KGSM.Journal" Version="2.1.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Expose internal domain/driver primitives to the test project. -->
    <InternalsVisibleTo Include="Firewall.Tests" />
  </ItemGroup>

  <Target Name="SetSourceRevisionId" BeforeTargets="GetAssemblyVersion;GenerateAssemblyInfo;CoreCompile"
          Condition="'$(SourceRevisionId)' == ''">
    <Exec Command="git -C &quot;$(MSBuildProjectDirectory)&quot; rev-parse --short=12 HEAD"
          ConsoleToMSBuild="true" ContinueOnError="true" StandardErrorImportance="low" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitShortSha" />
      <Output TaskParameter="ExitCode" PropertyName="_GitExitCode" />
    </Exec>
    <PropertyGroup Condition="'$(_GitExitCode)' == '0' and '$(_GitShortSha)' != ''">
      <SourceRevisionId>$(_GitShortSha)</SourceRevisionId>
    </PropertyGroup>
  </Target>

</Project>
