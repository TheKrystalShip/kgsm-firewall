<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <RootNamespace>TheKrystalShip.KGSM.Firewall.Contracts</RootNamespace>
    <AssemblyName>TheKrystalShip.KGSM.Firewall.Contracts</AssemblyName>

    <!-- net10.0: both consumers are now net10 — the Native-AOT daemon (Firewall.csproj) and kgsm-lib
         (which retargeted from net9.0 to net10.0 in the ecosystem-wide bump). Reflection-free
         (source-generated JSON) and trim/AOT-clean so neither consumer's publish warns — the daemon is
         Native-AOT and kgsm-lib is IsAotCompatible. NO kgsm-lib / TheKrystalShip.KGSM.Lib reference:
         kgsm-lib consumes THIS package, not the other way round (that would be a dependency cycle), and
         this package owns its own PortDto, never kgsm-lib's PortMapping. -->
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- NuGet packaging (resolved by kgsm-lib from the local-nuget folder feed). -->
    <PackageId>TheKrystalShip.KGSM.Firewall.Contracts</PackageId>
    <Version>1.2.0</Version>
    <Authors>TheKrystalShip</Authors>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <Description>Wire contracts for the kgsm-firewall host-firewall authority control socket: the
      newline-delimited-JSON request/response DTOs, the op/outcome tokens, the framing, and the
      source-generated JSON context. Consumed by kgsm-lib's IFirewallService; the daemon shares this
      single definition so the two cannot drift.</Description>
    <PackageReleaseNotes>1.1.0 — add the backend ENFORCEMENT axis (additive, backward-compatible). New
      nullable FirewallResponse.Enforcement (an Enforcements token: enforcing|inactive|unknown) reports
      whether the backend is actually filtering, so a consumer never reads an inactive firewall as
      "closed" (an inactive ufw filters nothing → every port is reachable). New Outcomes.AppliedInactive
      ("applied-inactive") distinguishes a rule that was staged while the backend is inactive (enforces on
      `ufw enable`) from an enforced Applied. A pre-1.1.0 daemon omits Enforcement (null) → the client
      reads Unknown and falls back to its prior behaviour. No fields removed or renamed.
      1.0.0 — initial public wire contract.</PackageReleaseNotes>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <IncludeSymbols>false</IncludeSymbols>
  </PropertyGroup>

</Project>
