<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <RootNamespace>TheKrystalShip.KGSM.Firewall.Contracts</RootNamespace>
    <AssemblyName>TheKrystalShip.KGSM.Firewall.Contracts</AssemblyName>

    <!-- Reflection-free (source-generated JSON) and trim/AOT-clean, so a Native-AOT consumer's publish stays
         clean. This package owns its own PortDto and depends on no other KGSM package. -->
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- NuGet packaging. -->
    <PackageId>TheKrystalShip.KGSM.Firewall.Contracts</PackageId>
    <Version>1.5.0-dev.1</Version>
    <Authors>TheKrystalShip</Authors>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <Description>The kgsm-firewall host-firewall authority's control-socket contract: the newline-delimited-JSON request/response DTOs, the op/outcome tokens, the framing, the source-generated JSON context and the typed client (IFirewallService) over the socket. The daemon shares the wire definitions, so the two cannot drift.</Description>
    <PackageReleaseNotes>1.1.0 — add the backend ENFORCEMENT axis (additive, backward-compatible). New
      nullable FirewallResponse.Enforcement (an Enforcements token: enforcing|inactive|unknown) reports
      whether the backend is actually filtering, so a consumer never reads an inactive firewall as
      "closed" (an inactive ufw filters nothing → every port is reachable). New Outcomes.AppliedInactive
      ("applied-inactive") distinguishes a rule that was staged while the backend is inactive (enforces on
      `ufw enable`) from an enforced Applied. A pre-1.1.0 daemon omits Enforcement (null) → the client
      reads Unknown and falls back to its prior behaviour. No fields removed or renamed.
      1.0.0 — initial public wire contract.</PackageReleaseNotes>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <IncludeSymbols>false</IncludeSymbols>
  </PropertyGroup>

  <ItemGroup>
    <!-- Abstractions only: the client logs and registers itself, and builds no container or host. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
  </ItemGroup>

</Project>
