# kgsm-firewall optional configuration. Copy to /etc/kgsm-firewall/kgsm-firewall.env and edit.
# The authoritative list (with defaults) is printed by: kgsm-firewall --help

# Force the firewall backend instead of auto-detecting it.
#   none | ufw | firewalld | nftables | iptables
# Default: auto-detect (precedence: active ufw/firewalld > nft > iptables > none).
#KGSM_FIREWALL_BACKEND=ufw

# Directory ufw reads application profiles from (where the authority writes kgsm-<instance> profiles).
# Default: /etc/ufw/applications.d
#KGSM_FIREWALL_UFW_APPLICATIONS_DIR=/etc/ufw/applications.d

# Control socket path. MUST match the ListenStream in kgsm-firewall.socket if you change it.
# Default: /run/kgsm-firewall/firewall.sock
#KGSM_FIREWALL_SOCKET=/run/kgsm-firewall/firewall.sock
