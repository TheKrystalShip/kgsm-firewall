[Unit]
Description=KGSM Firewall authority (host-firewall writes for KGSM)
Documentation=https://github.com/TheKrystalShip
# Socket activation handles ordering, but make the relationship explicit: this service exists to serve
# that socket, and should never be started without it.
Requires=kgsm-firewall.socket
After=kgsm-firewall.socket

# On-demand activation + idle-exit means many quick start/exit cycles are normal (each burst of firewall
# ops wakes the daemon; it then idle-exits). Disable systemd's start-rate limit so a tight burst can never
# trip it and refuse to re-activate — under the Inc-3 hard-fail contract an unreachable authority aborts a
# firewall-enabled install. (Idle-exit returns 0, so Restart=on-failure never fires on it either.)
StartLimitIntervalSec=0

[Service]
Type=simple
# Native-AOT single-file binary. Runs as ROOT: it must drive `ufw` (privileged) and write profile files
# under /etc/ufw/applications.d. Unlike kgsm-watchdog it spawns no untrusted children and does NOT drop
# privilege after boot — the socket's filesystem perms (root:kgsm 0660, set on the .socket unit) are the
# only access boundary. The daemon adopts systemd's socket (fd 3), serves, and idle-exits after
# Firewall__IdleTimeoutSeconds seconds with no connections (default 30) so it does not hold root 24/7 —
# systemd re-activates it on the next connection. Set the timeout to 0 to keep it resident.
ExecStart=/opt/kgsm-firewall/kgsm-firewall serve

# This authority's own event journal lives here (/var/lib/kgsm-firewall/events). systemd creates the
# directory before the daemon starts, which matters because the daemon may idle-exit between requests and
# a reader discovers a producer by finding its journal.
# 0755, not the systemd default 0700: this service runs as root and EVERY reader on the host
# (kgsm-api, the bot, the assistant) is unprivileged. The record holds which ports were opened — no
# credential — and a directory they cannot enter would report this authority's history as unreadable,
# which is indistinguishable from a genuine read failure.
StateDirectory=kgsm-firewall
StateDirectoryMode=0755

# The socket path the binary advertises to its bundled client must match the .socket unit's ListenStream.
Environment=Firewall__SocketPath=/run/kgsm-firewall/firewall.sock
# Optional extra knobs (Firewall__Backend, Firewall__UfwApplicationsDirectory). The leading '-' makes
# the file optional. Run `/opt/kgsm-firewall/kgsm-firewall --help` for the authoritative knob list.
EnvironmentFile=-/etc/kgsm-firewall/kgsm-firewall.env

# Do NOT lock the filesystem down (no ProtectSystem=strict, no ReadOnlyPaths over /etc/ufw): the daemon
# rewrites ufw application profiles there. It speaks only AF_UNIX itself, but the `ufw`/iptables children
# it spawns need netlink, so RestrictAddressFamilies is intentionally left unset.
Restart=on-failure
RestartSec=2

# No [Install]/WantedBy: this unit is pulled in by the socket on demand, never enabled on its own. Enable
# kgsm-firewall.socket instead (`systemctl enable --now kgsm-firewall.socket`).
